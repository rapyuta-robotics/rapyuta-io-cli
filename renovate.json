{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>rapyuta-robotics/workflows//renovate/default"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "groupName": "security updates",
    "groupSlug": "security-updates",
    "separateMajorMinor": false
  },
  "packageRules": [
    {
      "description": "Commit prefix for Python and GitHub Actions updates.",
      "matchManagers": ["pep621", "github-actions"],
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Pinned with == in pyproject.toml, so ignored.",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["yaspin", "python-benedict"],
      "enabled": false
    },
    {
      "description": "All Python majors share one PR per run.",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["major"],
      "groupName": "python dependencies",
      "groupSlug": "python"
    },
    {
      "description": "All GitHub Actions majors share one PR per run, separate from Python.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Every update waits for a human to review and merge it, even when CI passes.",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}
